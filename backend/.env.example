# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME="Smart University Automation System"
APP_VERSION="1.0.0"
DEBUG=True

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./smartuniversity.db

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_university_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_NAME="Smart University"
SMTP_FROM_EMAIL=your_university_email@gmail.com
SMTP_USE_TLS=True

# ─── Frontend URL (used in email links) ───────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── RPA / Logs ───────────────────────────────────────────────────────────────
ROBOT_LOG_DIR=../logs
ROBOT_REPORTS_DIR=../reports
